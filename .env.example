# --- LLM ---------------------------------------------------------------
# With a key, products call Claude directly.
# Without one, every thinking step is saved to clients/<slug>/out/pending/
# so a Claude session (Claude Code or claude.ai with this repo) can complete it
# and you run `mm submit <file>`.
ANTHROPIC_API_KEY=
MM_MODEL=claude-sonnet-5-5
MM_MODEL_FAST=claude-haiku-5-5

# --- Store ---------------------------------------------------------------
# file (default, zero setup) or supabase
MM_STORE=file
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Platform APIs (optional; used for headless runs) ----------------------
META_ACCESS_TOKEN=
APOLLO_API_KEY=

# --- Lead intake ---------------------------------------------------------
# Where generated landing-page forms POST to (Supabase edge function URL)
MM_LEAD_ENDPOINT=
# Optional webhook to alert you about hot leads (Slack/Zapier/etc.)
MM_ALERT_WEBHOOK=
